models/
checkpoints/
*.pt
*.bin
*.safetensors

# --- Notebooks ---
.ipynb_checkpoints/

# --- Testing ---
.pytest_cache/
.coverage

# --- Editors and operating systems ---
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
